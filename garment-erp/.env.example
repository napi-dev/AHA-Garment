# Copy this file to .env.local and fill in values

# PostgreSQL remote database URL
DATABASE_URL=""



# Auth.js secret - generate with: openssl rand -base64 32
AUTH_SECRET=""

# Optional: Telegram Bot
TELEGRAM_BOT_TOKEN=":"
TELEGRAM_MANAGER_CHAT_ID=""
TELEGRAM_ADMIN_CHAT_ID=""
TELEGRAM_DEPT_GROUP_CHAT_ID=""
TELEGRAM_DEV_CHAT_ID=""

# Telegram Public (for client-side display only - no secrets)
NEXT_PUBLIC_TELEGRAM_MANAGER_CHAT_ID=""
NEXT_PUBLIC_TELEGRAM_ADMIN_CHAT_ID=""
NEXT_PUBLIC_TELEGRAM_DEPT_GROUP_CHAT_ID="-"

# Optional: Google Drive
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
GOOGLE_DRIVE_ROOT_FOLDER_ID=""

# Optional: AI summary (Gemini free tier)
GEMINI_API_KEY=""

# App
NEXT_PUBLIC_APP_NAME="ልብስ ፋብሪካ ሥርዓት"
NODE_ENV="development"
