// Garment ERP - Prisma Schema v2
// Database: PostgreSQL (remote)
// Money: Decimal(10,2) — never Float
//
// v2 Clean Implementation - No v1 compatibility
// Starting fresh with clean database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  ADMIN              // ባለቤት (Owner) - everything
  PRODUCTION_MANAGER // የምርት ኃላፊ (PMG) - almost everything except owner-only items
  ORDER_PLACER       // የትዕዛዝ ተቀባይ - orders + shop
  LINE_SUPERVISOR    // የመስመር ሱፐርቫይዘር - attendance + counts for own line
  STORE_KEEPER       // የመጋዘን ኃላፊ
  CUTTING_MANAGER    // የቆረጣ ኃላፊ (Cutting lead)
  QC_INSPECTOR       // የጥራት ተቆጣጣሪ
}

enum AttendanceStatus {
  PRESENT                  // አለ - full day
  ABSENT_UNAUTHORIZED      // ቀሪ - −1 day salary
  ABSENT_AUTHORIZED        // ፈቃድ - −½ day salary
  SICK_LEAVE              // የሃኪም ማስረጃ - no penalty, no bonus
}

enum EntryStatus {
  DRAFT
  SUBMITTED
  VERIFIED
  LOCKED
}

enum IncentiveStatementStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  LOCKED
}

enum OffenceLevel {
  FIRST   // 2x mistake deduction from incentive
  SECOND  // incentive suspended for 2 months (4 periods)
  THIRD   // written warning + HR case
  FOURTH  // up to termination
}

enum AlertType {
  LOW_STOCK
  WASTAGE
  CONSUMPTION            // fabric consumption alert
  DELAYED_ORDER
  ORDER_COUNTDOWN        // 72/48/24h alerts
  FLOW_VARIANCE          // handover mismatch
  SHOP_SOLD_OUT          // shop stock zero
  ATTENDANCE_MISSING     // day without attendance
  REPORT_FAILED
  DAY_NOT_CLOSED
  UNUSUAL_COUNT
  HR_CASE
  SALARY_CHANGED
}

enum StockMovementType {
  RECEIVE
  ISSUE
  RETURN
  ADJUST
}

enum ReportType {
  DAILY_SUMMARY
  DAILY_PRODUCTION_SHEET
  DAILY_PIECE_COUNT
  RUNNING_INCENTIVE
  INCENTIVE_STATEMENT
  MONTHLY_INCENTIVE_SUMMARY
  MONTHLY_SALARY_SCHEDULE
  DAILY_INVENTORY
  CUTTING_WASTAGE
  EMPLOYEE_PRODUCTIVITY
  ORDER_STATUS
}

enum ShopMoveType {
  RECEIVE   // መቀበያ
  SALE      // ሽያጭ
  RETURN    // ወደ ፋብሪካ ተመላሽ
}

enum ShopSource {
  FACTORY    // ፋብሪካ
  RETURN     // ትዕዛዝ ተመላሽ
  OTHER      // ሌላ
}

enum Unit {
  PCS  // pieces
  KG   // kilograms
}

enum Size {
  S
  M
  L
  XL
  XXL
}

enum OrderStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

// ─────────────────────────────────────────────
// USERS & ROLES
// ─────────────────────────────────────────────

model AppUser {
  id            String    @id @default(cuid())
  employeeCode  String    @unique // e.g. "ADM-001", "PMG-001", "SUP-001"
  nameAm        String?   // Display name in Amharic
  pinHash       String    // bcrypt hash of 4-6 digit PIN
  role          Role
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  employee      Employee? @relation(fields: [employeeId], references: [id])
  employeeId    String?   @unique

  auditLogs     AuditLog[]
  telegramRecipient TelegramRecipient?

  @@index([role])
}

// ─────────────────────────────────────────────
// DEPARTMENTS (flow stages) & JOBS (rate carriers)
// ─────────────────────────────────────────────

model Department {
  id          String   @id @default(cuid())
  nameAm      String   @unique
  nameEn      String?
  flowOrder   Int?     // null = not in flow (e.g. አስተዳደር)
  controllers Role[]   // who can control this department (ADMIN is implicit)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobs        Job[]
  employees   Employee[]
  hourlyBoxes HourlyBox[]
  handoversFrom Handover[] @relation("HandoverFromDept")
  handoversTo   Handover[] @relation("HandoverToDept")
  offences    Offence[]
  defects     Defect[]

  @@index([flowOrder])
}

model Job {
  id           String     @id @default(cuid())
  nameAm       String
  nameEn       String?
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  isActive     Boolean    @default(true)
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  employees      Employee[]
  incentiveCards IncentiveCard[]
  incentiveLines IncentiveLine[]
  hourlyBoxes    HourlyBox[]

  @@unique([departmentId, nameAm])
  @@index([departmentId])
}

// ─────────────────────────────────────────────
// EMPLOYEES
// ─────────────────────────────────────────────

model Employee {
  id            String    @id @default(cuid())
  serialNumber  Int       @unique // auto-assigned sequential number
  employeeCode  String?   @unique // e.g. "EMP-001" — display identifier
  nameAm        String    // Full name in Amharic
  nameEn        String?   // Optional English name
  
  departmentId  String
  department    Department @relation(fields: [departmentId], references: [id])
  
  jobId         String?   // Job carries the rate
  job           Job?      @relation(fields: [jobId], references: [id])
  
  lineNo        Int?      // 1, 2, or null (for non-line workers)
  
  isActive      Boolean   @default(true)
  hiredAt       DateTime? // Ethiopian calendar date stored as Gregorian
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          AppUser?
  salaryRecords SalaryRecord[]
  attendances   Attendance[]
  hourlyBoxes   HourlyBox[]
  incentiveLines IncentiveLine[]
  offences      Offence[]
  suspensions   Suspension[]

  @@index([departmentId])
  @@index([jobId])
  @@index([isActive])
  @@index([lineNo])
}

// ─────────────────────────────────────────────
// SALARY (fixed, no arithmetic)
// ─────────────────────────────────────────────

model SalaryRecord {
  id           String    @id @default(cuid())
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id])
  amount       Decimal   @db.Decimal(10, 2) // ETB, exact
  effectiveFrom DateTime @db.Date
  effectiveTo  DateTime? // null = current
  setByUserId  String    // ADMIN only (PMG can only view)
  createdAt    DateTime  @default(now())

  @@index([employeeId, effectiveFrom])
}

model SalarySetting {
  id              String   @id @default(cuid())
  attendanceBonus Decimal  @db.Decimal(10, 2) @default(500) // 500 ETB default
  effectiveFrom   DateTime @db.Date
  setByUserId     String   // ADMIN only
  createdAt       DateTime @default(now())

  @@index([effectiveFrom])
}

// ─────────────────────────────────────────────
// INCENTIVE CARD (per JOB)
// ─────────────────────────────────────────────

model IncentiveCard {
  id             String     @id @default(cuid())
  
  jobId          String
  job            Job        @relation(fields: [jobId], references: [id])
  
  targetPerHour  Int
  ratePerPiece   Decimal    @db.Decimal(6, 4)
  effectiveFrom  DateTime   @db.Date // must be 1st or 16th of month (or day 1 of Pagume)
  effectiveTo    DateTime?  @db.Date
  setByUserId    String
  createdAt      DateTime   @default(now())

  incentiveLines IncentiveLine[]

  @@unique([jobId, effectiveFrom])
  @@index([jobId, effectiveFrom])
}

// ─────────────────────────────────────────────
// ATTENDANCE (status enum replaces hoursWorked)
// ─────────────────────────────────────────────

model Attendance {
  id           String           @id @default(cuid())
  employeeId   String
  employee     Employee         @relation(fields: [employeeId], references: [id])
  date         DateTime         @db.Date
  
  status       AttendanceStatus @default(PRESENT)
  
  enteredById  String
  lockedAt     DateTime?        // locked per supervisor per day
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([employeeId, date])
  @@index([date])
  @@index([status])
}

model AttendanceSubmission {
  id            String   @id @default(cuid())
  date          DateTime @db.Date
  supervisorId  String   // AppUser ID
  submittedAt   DateTime @default(now())

  @@unique([date, supervisorId])
  @@index([date])
}

// ─────────────────────────────────────────────
// HOURLY BOX & DAY CLOSE
// ─────────────────────────────────────────────

model HourlyBox {
  id             String     @id @default(cuid())
  date           DateTime   @db.Date
  employeeId     String
  employee       Employee   @relation(fields: [employeeId], references: [id])
  
  jobId          String
  job            Job        @relation(fields: [jobId], references: [id])
  
  departmentId   String
  department     Department @relation(fields: [departmentId], references: [id])

  // Actual pieces per hour (8 columns). Null = not worked that hour.
  h1  Int?
  h2  Int?
  h3  Int?
  h4  Int?
  h5  Int?
  h6  Int?
  h7  Int?
  h8  Int?

  // Derived (computed by server on save)
  totalProduced  Int     @default(0)
  targetForDay   Int     @default(0) // hourly_target × hours_worked
  plusPieces     Int     @default(0) // max(0, produced - target)
  minusPieces    Int     @default(0) // max(0, target - produced)

  mistakes       Int     @default(0)
  mistakeReason  String?

  supervisorId   String
  isLocked       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([date, employeeId])
  @@index([date])
  @@index([employeeId])
  @@index([jobId])
  @@index([departmentId])
}

model DayClose {
  id           String    @id @default(cuid())
  date         DateTime  @db.Date
  closedById   String
  closedAt     DateTime  @default(now())
  notes        String?

  reportJobs   ReportJob[]

  @@unique([date])
}

// ─────────────────────────────────────────────
// INCENTIVE PERIODS & STATEMENTS
// ─────────────────────────────────────────────

model IncentivePeriod {
  id           String    @id @default(cuid())
  periodNumber Int       // 1 or 2 (1 for Pagume)
  ethYear      Int
  ethMonth     Int       // 1–13
  startDate    DateTime  @db.Date
  endDate      DateTime  @db.Date
  paymentDay   Int?      // editable, can be empty
  status       IncentiveStatementStatus @default(DRAFT)
  approvedById String?   // ADMIN only
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  lines        IncentiveLine[]
  reportJobs   ReportJob[]

  @@unique([ethYear, ethMonth, periodNumber])
  @@index([status])
}

model IncentiveLine {
  id               String          @id @default(cuid())
  periodId         String
  period           IncentivePeriod @relation(fields: [periodId], references: [id])
  employeeId       String
  employee         Employee        @relation(fields: [employeeId], references: [id])
  
  jobId            String
  job              Job             @relation(fields: [jobId], references: [id])
  
  cardId           String
  card             IncentiveCard   @relation(fields: [cardId], references: [id])

  ratePerPiece     Decimal         @db.Decimal(6, 4)

  plusPieces       Int             @default(0)
  minusPieces      Int             @default(0)
  mistakes         Int             @default(0)

  calculated       Decimal         @db.Decimal(10, 2) // can be negative
  payable          Decimal         @db.Decimal(10, 2) // never below 0

  isSuspended      Boolean         @default(false)
  suspensionId     String?

  version          Int             @default(1)
  correctedFromId  String?
  correctionReason String?

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([periodId, employeeId])
  @@index([periodId])
  @@index([employeeId])
  @@index([jobId])
}

// ─────────────────────────────────────────────
// PENALTY LADDER (scoped to department)
// ─────────────────────────────────────────────

model Offence {
  id            String       @id @default(cuid())
  employeeId    String
  employee      Employee     @relation(fields: [employeeId], references: [id])
  
  departmentId  String
  department    Department   @relation(fields: [departmentId], references: [id])
  
  level         OffenceLevel
  date          DateTime     @db.Date
  reason        String
  recordedById  String
  relatedBoxId  String?
  createdAt     DateTime     @default(now())

  @@index([employeeId])
  @@index([departmentId])
}

model Suspension {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id])
  startDate   DateTime  @db.Date
  endDate     DateTime  @db.Date
  isActive    Boolean   @default(true)
  reason      String
  createdById String
  createdAt   DateTime  @default(now())

  @@index([employeeId, isActive])
}

// ─────────────────────────────────────────────
// MATERIALS & STOCK
// ─────────────────────────────────────────────

model Material {
  id           String   @id @default(cuid())
  sku          String   @unique
  nameAm       String
  nameEn       String?
  unit         String
  kind         String   @default("other") // "fabric" or "other"
  minimumLevel Decimal  @db.Decimal(10, 3)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  stockMovements StockMovement[]

  @@index([sku])
  @@index([kind])
}

model Supplier {
  id        String   @id @default(cuid())
  nameAm    String
  nameEn    String?
  contact   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  lots      Lot[]
}

model Lot {
  id           String    @id @default(cuid())
  lotNumber    String    @unique
  supplierId   String
  supplier     Supplier  @relation(fields: [supplierId], references: [id])
  receivedAt   DateTime
  notes        String?

  stockMovements StockMovement[]
}

model StockMovement {
  id           String            @id @default(cuid())
  materialId   String
  material     Material          @relation(fields: [materialId], references: [id])
  type         StockMovementType
  quantity     Decimal           @db.Decimal(10, 3)
  lotId        String?
  lot          Lot?              @relation(fields: [lotId], references: [id])
  reference    String?
  destination  String?           // for ISSUE type (e.g. "ቆራጭ")
  enteredById  String
  date         DateTime          @db.Date
  notes        String?
  createdAt    DateTime          @default(now())

  @@index([materialId, date])
  @@index([type])
}

// ─────────────────────────────────────────────
// ORDERS (with lines, deadlineAt, countdown)
// ─────────────────────────────────────────────

model ProdOrder {
  id          String       @id @default(cuid())
  orderNo     String       @unique // ORD-00001 (5 digits)
  deadlineAt  DateTime     // date + hour
  status      OrderStatus  @default(ACTIVE)
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  lines       OrderLine[]
  cutJobs     CutJob[]
  handovers   Handover[]
  shopMovements ShopMovement[]
  alerts      OrderAlert[]

  @@index([status])
  @@index([deadlineAt])
}

model OrderLine {
  id       String    @id @default(cuid())
  orderId  String
  order    ProdOrder @relation(fields: [orderId], references: [id])
  typeId   String    // from settings list
  color    String
  size     Size
  qty      Int
  createdAt DateTime @default(now())

  @@index([orderId])
}

model OrderAlert {
  id          String   @id @default(cuid())
  orderId     String
  order       ProdOrder @relation(fields: [orderId], references: [id])
  threshold   Int      // 72, 48, or 24 (hours)
  firedAt     DateTime @default(now())

  @@unique([orderId, threshold])
  @@index([orderId])
}

// ─────────────────────────────────────────────
// FLOW CONTROL (two-sided handovers)
// ─────────────────────────────────────────────

model Handover {
  id            String    @id @default(cuid())
  orderId       String
  order         ProdOrder @relation(fields: [orderId], references: [id])
  color         String?
  size          Size?
  
  fromDeptId    String?
  fromDept      Department? @relation("HandoverFromDept", fields: [fromDeptId], references: [id])
  
  toDeptId      String?
  toDept        Department? @relation("HandoverToDept", fields: [toDeptId], references: [id])
  
  unit          Unit      @default(PCS) // PCS or KG
  sentQty       Decimal   @db.Decimal(10, 3)
  sentById      String
  sentAt        DateTime  @default(now())
  
  receivedQty   Decimal?  @db.Decimal(10, 3)
  receivedById  String?
  receivedAt    DateTime?
  
  createdAt     DateTime  @default(now())

  investigation FlowInvestigation?

  @@index([orderId])
  @@index([fromDeptId])
  @@index([toDeptId])
}

model FlowInvestigation {
  id          String   @id @default(cuid())
  handoverId  String   @unique
  handover    Handover @relation(fields: [handoverId], references: [id])
  status      String   // "recount" | "found_in_rework" | "reported" | "resolved"
  reasonFound String?
  signedBy    String?
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
}

// ─────────────────────────────────────────────
// CUTTING (consumption = kg ÷ pieces)
// ─────────────────────────────────────────────

model CutJob {
  id              String    @id @default(cuid())
  orderId         String
  order           ProdOrder @relation(fields: [orderId], references: [id])
  fabricId        String    // Material ID
  kgReceived      Decimal   @db.Decimal(10, 3) // what cutting lead received
  piecesCut       Int
  consumption     Decimal   @db.Decimal(8, 4)  // kg ÷ pieces
  limitUsed       Decimal   @db.Decimal(5, 2)  // limit at time of cut
  date            DateTime  @db.Date
  cuttingLeadId   String
  notes           String?
  createdAt       DateTime  @default(now())

  @@index([orderId])
  @@index([date])
}

// ─────────────────────────────────────────────
// SHOP (three movement types)
// ─────────────────────────────────────────────

model ShopMovement {
  id          String        @id @default(cuid())
  type        ShopMoveType  // RECEIVE | SALE | RETURN
  source      ShopSource?   // only for RECEIVE
  orderId     String?
  order       ProdOrder?    @relation(fields: [orderId], references: [id])
  typeId      String        // garment type
  color       String
  size        Size
  qty         Int
  unitPrice   Decimal?      @db.Decimal(10, 2) // only for SALE
  total       Decimal?      @db.Decimal(10, 2) // qty × unitPrice
  buyerName   String?       // only for SALE
  date        DateTime      @db.Date
  enteredById String
  voidedAt    DateTime?
  voidReason  String?
  createdAt   DateTime      @default(now())

  @@index([type])
  @@index([orderId])
  @@index([date])
}

// ─────────────────────────────────────────────
// QUALITY CONTROL
// ─────────────────────────────────────────────

model Defect {
  id                String   @id @default(cuid())
  orderId           String   // which order
  defectType        String
  
  responsibleDeptId String
  responsibleDept   Department @relation(fields: [responsibleDeptId], references: [id])
  
  responsibleEmpId  String?
  piecesAffected    Int
  repaired          Boolean  @default(false)
  repairedById      String?
  repairedAt        DateTime?
  date              DateTime @db.Date
  notes             String?
  createdAt         DateTime @default(now())

  @@index([responsibleDeptId])
  @@index([orderId])
}

// ─────────────────────────────────────────────
// AUTOMATION: REPORTS & TELEGRAM
// ─────────────────────────────────────────────

model ReportJob {
  id           String     @id @default(cuid())
  type         ReportType
  periodDate   DateTime   @db.Date
  status       String     @default("pending")
  retryCount   Int        @default(0)
  driveFileId  String?
  driveUrl     String?
  telegramMsgId String?
  version      Int        @default(1)
  errorMessage String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  dayClose     DayClose?  @relation(fields: [dayCloseId], references: [id])
  dayCloseId   String?
  period       IncentivePeriod? @relation(fields: [periodId], references: [id])
  periodId     String?
}

model GeneratedReport {
  id          String     @id @default(cuid())
  type        String     // DAILY_PDF | INCENTIVE_STATEMENT | MONTHLY_SUMMARY etc.
  periodKey   String     // "2019-01-P1" or "2019-02-15"
  pdf         Bytes      // stored PDF
  sentStatus  String     @default("pending") // pending | sent | failed
  createdAt   DateTime   @default(now())
  createdById String

  @@index([type, periodKey])
  @@index([createdAt])
}

model TelegramRecipient {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        AppUser   @relation(fields: [userId], references: [id])
  chatId      String
  verifiedAt  DateTime?
  isActive    Boolean   @default(true)
  allowedReports ReportType[]
  createdAt   DateTime  @default(now())
}

// ─────────────────────────────────────────────
// ALERTS (expanded types, scoped recipients)
// ─────────────────────────────────────────────

model Alert {
  id          String    @id @default(cuid())
  type        AlertType
  message     String
  reference   String?
  sentAt      DateTime?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([type, resolvedAt])
}

// ─────────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(cuid())
  userId      String
  user        AppUser  @relation(fields: [userId], references: [id])
  action      String
  entity      String
  entityId    String
  before      Json?
  after       Json?
  reason      String?
  actedAsManager Boolean @default(false)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// APP SETTINGS
// ─────────────────────────────────────────────

model AppSetting {
  key       String @id
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String
}
